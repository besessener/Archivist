{
  "name": "archivist",
  "productName": "Archivist",
  "version": "0.1.3",
  "description": "Archivist – dein persönlicher Archivar (lokale Desktop-Anwendung für Windows)",
  "author": {
    "name": "Matthias Eggert",
    "url": "https://github.com/besessener"
  },
  "license": "MIT",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "electron-builder --win nsis portable --x64 --publish never",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "release:win": "electron-builder --win nsis portable --x64 --publish always"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@napi-rs/canvas": "^1.0.9",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "^6.3.289",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@archivist/core": "*",
    "@archivist/shared": "*",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/besessener/archivist.git"
  }
}
