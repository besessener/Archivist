# Archivist does NOT read .env files automatically. These variables can be set before starting the application
# (development, tests, portable use). In normal operation the API key does NOT belong here but in the
# setup dialog (stored encrypted with Electron safeStorage).

# Data directory (default: ~/Documents/Archivist)
ARCHIVIST_DATA_DIR=

# Development/CI only: API key from the environment instead of secure storage (never commit it to the repository!)
ARCHIVIST_LLM_API_KEY=

# Development only: Next.js dev server instead of the bundled frontend (set automatically by `npm run dev`)
ARCHIVIST_DEV_URL=

# Tests only: allows the insecure "basic_text" fallback of safeStorage on Linux without a keyring
ARCHIVIST_TEST_MODE=
# Tests only: replaces the native directory picker dialog
ARCHIVIST_TEST_PICK_DIR=
# Tests only: model of the speech input served by the test (JSON) and a stand-in worker instead of the real Whisper worker
ARCHIVIST_TEST_SPEECH_MODELS=
ARCHIVIST_TEST_SPEECH_WORKER=
