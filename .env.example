# Archivist liest KEINE .env-Dateien automatisch. Diese Variablen können vor dem Start der Anwendung gesetzt werden
# (Entwicklung, Tests, portable Nutzung). Der API-Key gehört im Normalbetrieb NICHT hierher, sondern in den
# Einrichtungsdialog (wird mit Electron safeStorage verschlüsselt gespeichert).

# Datenverzeichnis (Standard: ~/Documents/Archivist)
ARCHIVIST_DATA_DIR=

# Nur Entwicklung/CI: API-Key aus der Umgebung statt aus dem sicheren Speicher (nie ins Repository einchecken!)
ARCHIVIST_LLM_API_KEY=

# Nur Entwicklung: Next.js-Dev-Server statt gebündeltem Frontend (setzt `npm run dev` automatisch)
ARCHIVIST_DEV_URL=

# Nur Tests: erlaubt unter Linux ohne Schlüsselbund den unsicheren "basic_text"-Fallback von safeStorage
ARCHIVIST_TEST_MODE=
# Nur Tests: ersetzt den nativen Verzeichnis-Auswahldialog
ARCHIVIST_TEST_PICK_DIR=
