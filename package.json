{
  "name": "archivist-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Archivist – dein persönlicher Archivar (lokale Desktop-Anwendung für Windows)",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "db:generate": "npm run db:generate -w @archivist/core",
    "build": "npm run build -w @archivist/renderer && npm run build -w archivist",
    "dev": "npm run dev -w archivist",
    "start": "npm run build && npm run start -w archivist",
    "dist": "npm run build && npm run dist -w archivist",
    "dist:win": "npm run build && npm run dist:win -w archivist",
    "release:win": "npm run build && npm run release:win -w archivist",
    "native:check": "node scripts/check-native.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise --config .dependency-cruiser.cjs packages apps/desktop/src apps/renderer tests",
    "knip": "knip",
    "test:mutation": "stryker run",
    "mutation:summary": "node scripts/mutation-summary.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.13.0",
    "better-sqlite3": "^13.0.3",
    "dependency-cruiser": "^18.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.12.0",
    "jszip": "^3.10.2",
    "knip": "^6.39.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@electron/asar": "^4.3.1",
    "rimraf": "^6.0.0",
    "glob": "^13.0.6",
    "qs": "^6.16.0",
    "boolean": "file:tools/boolean-shim",
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
